<?xml version="1.0" encoding="utf-8"?>
<resources
    xmlns:tools="http://schemas.android.com/tools"
    >

    <style name="LightTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/hupisan_primary_dark</item>
        <item name="colorPrimaryVariant">@color/hupisan_primary_surface</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/hupisan_accent_amber</item>
        <item name="colorSecondaryVariant">@color/hupisan_primary_surface</item>
        <item name="colorOnSecondary">@color/hupisan_primary_dark</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/hupisan_primary_dark</item>
        <item name="android:windowBackground">@color/hupisan_page_bg</item>
        <!-- Customize your theme here. -->
    </style>


    <style name="DarkTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/hupisan_accent_amber</item>
        <item name="colorPrimaryVariant">@color/hupisan_primary_surface</item>
        <item name="colorOnPrimary">@color/hupisan_primary_dark</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/hupisan_accent_amber</item>
        <item name="colorSecondaryVariant">@color/hupisan_primary_surface</item>
        <item name="colorOnSecondary">@color/hupisan_primary_dark</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/hupisan_primary_dark</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="FabDiamondOverlay" parent="">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">25dp</item>
        <item name="colorControlNormal">@color/hupisan_accent_amber</item>
    </style>

    <style name="BottomAppBarTheme" parent="Widget.MaterialComponents.BottomAppBar.Colored">
        <item name="android:itemBackground">@color/hupisan_primary_dark</item>
    </style>
</resources>