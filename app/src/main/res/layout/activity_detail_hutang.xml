<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_root_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hupisan_page_bg"
    tools:context=".view.hutang.DetailHutangActivity">

    <!-- TOP TOOLBAR -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/custom_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_baseline_arrow_back_24"
                app:tint="@color/hupisan_text_primary" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/detail_hutang"
            android:textColor="@color/hupisan_text_primary"
            android:textSize="19sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <FrameLayout
            android:id="@+id/btn_menu_more"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_baseline_menu_24"
                app:tint="@color/hupisan_text_primary" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_actions"
        app:layout_constraintTop_toBottomOf="@id/custom_toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- PROFILE HEADER (Avatar Circle + Name + Role) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/layout_avatar_circle"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_summary_wallet_circle">

                    <TextView
                        android:id="@+id/tv_avatar_letter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="B"
                        android:textColor="@color/hupisan_text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_profile_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Budi Santoso"
                        android:textColor="@color/hupisan_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_profile_role"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/debitur"
                        android:textColor="@color/hupisan_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- BIG SUMMARY CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardPreventCornerOverlap="false"
                app:cardUseCompatPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:id="@+id/tv_main_total_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 500.000"
                        android:textColor="@color/hupisan_text_primary"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_main_total_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/total_hutang"
                        android:textColor="@color/hupisan_text_secondary"
                        android:textSize="12sp" />

                    <!-- Two columns (Sudah Dibayar & Sisa Tagihan) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <!-- Left Column -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_amount_paid"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rp 0"
                                android:textColor="@color/hupisan_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/sudah_dibayar"
                                android:textColor="@color/hupisan_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Vertical Divider -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="@color/hupisan_card_stroke" />

                        <!-- Right Column -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_amount_remaining"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rp 500.000"
                                android:textColor="@color/hupisan_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/sisa_tagihan"
                                android:textColor="@color/hupisan_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Status Pill -->
                    <TextView
                        android:id="@+id/tv_status_badge_card"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_badge_belum_lunas"
                        android:paddingStart="14dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="4dp"
                        android:text="@string/belum_lunas"
                        android:textColor="@color/hupisan_debt_text"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- INFO ROW 1: Jatuh Tempo -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardPreventCornerOverlap="false"
                app:cardUseCompatPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_input_multiline">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_hupisan_calendar"
                            app:tint="@color/hupisan_text_secondary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/jatuh_tempo"
                            android:textColor="@color/hupisan_text_secondary"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/tv_info_jatuh_tempo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="19 Nov 2026 - 14:54"
                            android:textColor="@color/hupisan_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- INFO ROW 2: Catatan -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardPreventCornerOverlap="false"
                app:cardUseCompatPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_input_multiline">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_hupisan_document"
                            app:tint="@color/hupisan_text_secondary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/catatan"
                            android:textColor="@color/hupisan_text_secondary"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/tv_info_catatan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Pinjaman untuk belanja"
                            android:textColor="@color/hupisan_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SECTION: Riwayat Pembayaran -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/riwayat_pembayaran"
                    android:textColor="@color/hupisan_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_baseline_keyboard_arrow_up_24"
                    app:tint="@color/hupisan_text_secondary" />
            </LinearLayout>

            <!-- Payment Empty Box -->
            <LinearLayout
                android:id="@+id/layout_payment_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input_multiline"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="20dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_hupisan_wallet"
                    app:tint="@color/hupisan_text_muted" />

                <TextView
                    android:id="@+id/tv_payment_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/belum_ada_pembayaran"
                    android:textColor="@color/hupisan_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Payment RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_data_pembayaran_from_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <!-- Hidden compatibility views -->
            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/app_bar_layout"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone">
                <com.google.android.material.appbar.CollapsingToolbarLayout
                    android:id="@+id/collapsing_toolbar"
                    android:layout_width="0dp"
                    android:layout_height="0dp">
                    <androidx.appcompat.widget.Toolbar
                        android:id="@+id/anim_toolbar"
                        android:layout_width="0dp"
                        android:layout_height="0dp" />
                    <FrameLayout
                        android:id="@+id/stuff_container"
                        android:layout_width="0dp"
                        android:layout_height="0dp" />
                    <FrameLayout
                        android:id="@+id/fl_background"
                        android:layout_width="0dp"
                        android:layout_height="0dp" />
                    <ImageView
                        android:id="@+id/imgb_avatar_wrap"
                        android:layout_width="0dp"
                        android:layout_height="0dp" />
                    <ImageView
                        android:id="@+id/imgb_avatar_gender"
                        android:layout_width="0dp"
                        android:layout_height="0dp" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_profile_name_single"
                        android:layout_width="0dp"
                        android:layout_height="0dp" />
                </com.google.android.material.appbar.CollapsingToolbarLayout>
            </com.google.android.material.appbar.AppBarLayout>

            <!-- Include legacy content layout as hidden to satisfy data binding -->
            <include
                android:id="@+id/content"
                layout="@layout/content_detail_hutang"
                android:visibility="gone" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_tambahkan"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_lunas"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_cicil"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/option_f"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM ACTION BUTTONS: [✏️ Edit] and [💳 Tambah Pembayaran] -->
    <LinearLayout
        android:id="@+id/layout_bottom_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/hupisan_page_bg"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Left: Edit Button (Outline Green) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_action_edit"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="0.8"
            android:text="@string/edit"
            android:textColor="@color/hupisan_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_hupisan_edit"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconTint="@color/hupisan_primary"
            app:strokeColor="@color/hupisan_primary"
            app:strokeWidth="1.5dp" />

        <!-- Right: Tambah Pembayaran Button (Solid Green) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_action_add_payment"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1.2"
            android:backgroundTint="@color/hupisan_primary"
            android:text="@string/tambah_pembayaran"
            android:textColor="@color/white"
            android:textSize="13.5sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:elevation="2dp"
            app:icon="@drawable/ic_hupisan_payment_card"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconTint="@color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
