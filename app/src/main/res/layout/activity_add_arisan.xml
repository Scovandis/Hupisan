<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/constraint"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.arisan.AddArisanActivity">
    <androidx.core.widget.NestedScrollView
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ProgressBar
                android:id="@+id/progressbar"
                android:translationZ="@dimen/_5sdp"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:progressDrawable="@drawable/custom_progressbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        <LinearLayout
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_width="match_parent"
            android:layout_margin="@dimen/_8sdp"
            android:orientation="vertical"
            android:paddingBottom="@dimen/_55sdp"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:id="@+id/cardView1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:elevation="@dimen/_3sdp"
                app:cardCornerRadius="@dimen/_5sdp"
                app:cardElevation="@dimen/_2sdp"
                app:cardPreventCornerOverlap="false"
                app:cardUseCompatPadding="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:padding="@dimen/_8sdp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <ImageView
                            android:src="@drawable/ic_dibuat_pada"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                             />
                        <View
                            android:layout_width="1dp"
                            android:background="@color/transparantBlack15"
                            android:layout_marginStart="@dimen/_8sdp"
                            android:layout_marginEnd="@dimen/_8sdp"
                            android:layout_height="match_parent"/>
                        <TextView
                            android:id="@+id/tv_create_at"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/et_nama_group"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/group_name"
                        android:maxLines="1"
                        android:textStyle="normal"
                        app:boxBackgroundColor="@android:color/transparent"
                        app:counterEnabled="true"
                        app:counterMaxLength="20"
                        app:errorEnabled="true"
                        >

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLength="20" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/et_prize_poll"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/prize_poll"
                        android:inputType="number"
                        android:maxLines="1"
                        app:counterEnabled="true"
                        app:counterMaxLength="9"
                        app:boxBackgroundColor="@android:color/transparent"
                        app:errorEnabled="true"
                        app:helperText="@string/masukkan_jumlah_nominal"
                        app:helperTextEnabled="true"
                        app:prefixText="@string/dolar">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="9"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/et_nominal_pembayaran"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/paymet_amount"
                        android:inputType="number"
                        android:maxLines="1"
                        app:counterEnabled="true"
                        app:counterMaxLength="9"
                        app:boxBackgroundColor="@android:color/transparent"
                        app:errorEnabled="true"
                        app:helperText="@string/masukkan_jumlah_nominal"
                        app:helperTextEnabled="true"
                        app:prefixText="@string/dolar">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLength="9"
                            android:inputType="number"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_simpan_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        app:cornerRadius="@dimen/_5sdp"
                        android:text="@string/buat_group"
                        app:layout_goneMarginBottom="@dimen/_24sdp"
                        />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@+id/cardView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:elevation="@dimen/_3sdp"
                app:cardCornerRadius="@dimen/_5sdp"
                app:cardElevation="@dimen/_2sdp"
                app:cardPreventCornerOverlap="false"
                app:cardUseCompatPadding="true"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:layout_marginBottom="@dimen/_4sdp"
                        android:textStyle="bold"
                        android:textSize="@dimen/_18sdp"
                        android:text="@string/anggota"
                        />
                    <TextView
                        android:layout_marginTop="@dimen/_8sdp"
                        android:layout_width="match_parent"
                        android:textStyle="normal"
                        android:text="@string/untuk_membuat_group_kamu_harus_memasukkan_minimal_3_nama_anggota_untuk_memulainya"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:textSize="@dimen/_10sdp"
                        android:layout_height="wrap_content"/>


                    <LinearLayout
                        android:id="@+id/linearlayout_member1"
                        android:layout_width="match_parent"
                        android:layout_margin="@dimen/_8sdp"
                        android:orientation="vertical"
                        android:layout_height="wrap_content"
                        >
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            >
                            <com.google.android.material.textfield.TextInputLayout
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toStartOf="@id/linear_pay1"
                                android:id="@+id/et_memeber_name1"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:hint="@string/member_name"
                                android:maxLines="1"
                                app:prefixText="1"
                                android:textStyle="normal"
                                app:boxBackgroundColor="@android:color/transparent"
                                app:counterEnabled="true"
                                app:counterMaxLength="20"
                                app:errorEnabled="true"
                                >

                                <com.google.android.material.textfield.TextInputEditText
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:maxLength="20" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <LinearLayout
                                android:id="@+id/linear_pay1"
                                android:gravity="center_horizontal"
                                app:layout_constraintTop_toTopOf="@id/et_memeber_name1"
                                app:layout_constraintEnd_toEndOf="parent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:padding="@dimen/_2sdp"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:orientation="horizontal"
                                >
                                <TextView
                                    android:paddingStart="@dimen/_2sdp"
                                    android:text="@string/bayar"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>

                                <com.google.android.material.switchmaterial.SwitchMaterial
                                    android:id="@+id/switch_on_pay1"
                                    android:layout_width="wrap_content"
                                    app:trackTint="@color/switch_track_selector"
                                    app:thumbTint="@color/switch_thumb_selector"
                                    android:layout_height="wrap_content"
                                    android:switchMinWidth="56dp"
                                    android:layout_marginStart="@dimen/_8sdp"
                                    android:textOff="@string/off"
                                    android:textOn="@string/on" />

                            </LinearLayout>

                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <RadioGroup
                            android:id="@+id/radio_group1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            app:layout_constraintStart_toStartOf="@id/cardView_tanggal"
                            app:layout_constraintTop_toBottomOf="@id/rl_view_gender">

                            <RadioButton
                                android:id="@+id/rb_gender_laki1"
                                android:layout_width="@dimen/_70sdp"
                                android:layout_height="wrap_content"
                                android:background="@drawable/radio_flat_selector"
                                android:button="@android:color/transparent"
                                android:checked="true"
                                android:gravity="center"
                                android:paddingLeft="@dimen/_4sdp"
                                android:paddingTop="@dimen/_3sdp"
                                android:paddingRight="@dimen/_4sdp"
                                android:paddingBottom="@dimen/_3sdp"
                                android:text="@string/laki_laki"
                                android:textColor="@color/color_flat_text_selector" />

                            <RadioButton
                                android:id="@+id/rb_gender_perempuan1"
                                android:layout_width="@dimen/_70sdp"
                                android:layout_height="wrap_content"
                                android:background="@drawable/radio_flat_selector"
                                android:button="@android:color/transparent"
                                android:gravity="center"
                                android:paddingLeft="@dimen/_4sdp"
                                android:paddingTop="@dimen/_3sdp"
                                android:paddingRight="@dimen/_4sdp"
                                android:paddingBottom="@dimen/_3sdp"
                                android:text="@string/perempuan"
                                android:textColor="@color/color_flat_text_selector" />

                            <RadioButton
                                android:id="@+id/rb_gender_lainnya1"
                                android:layout_width="@dimen/_70sdp"
                                android:layout_height="wrap_content"
                                android:background="@drawable/radio_flat_selector"
                                android:button="@android:color/transparent"
                                android:gravity="center"
                                android:paddingLeft="@dimen/_4sdp"
                                android:paddingTop="@dimen/_3sdp"
                                android:paddingRight="@dimen/_4sdp"
                                android:paddingBottom="@dimen/_3sdp"
                                android:text="@string/lainnya"
                                android:textColor="@color/color_flat_text_selector" />
                        </RadioGroup>
                        <TextView
                            android:id="@+id/tv_member_is_full"
                            android:text="@string/kamu_suadah_memasukkan_banyak_user_silahkan_simpan_terlebih_dahulu"
                            android:gravity="center"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_tambahkan_anggota"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cornerRadius="@dimen/_5sdp"
                            android:visibility="gone"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:text="@string/tambahkan_anggota"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_goneMarginBottom="@dimen/_24sdp"
                            />

                        <androidx.recyclerview.widget.RecyclerView
                            android:visibility="gone"
                            android:id="@+id/rv_anggota"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_10sdp"
                            />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_simpan_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cornerRadius="@dimen/_5sdp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="@dimen/_16sdp"
        android:translationZ="@dimen/_4sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:text="@string/simpan"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_goneMarginBottom="@dimen/_24sdp"
        />
</androidx.constraintlayout.widget.ConstraintLayout>