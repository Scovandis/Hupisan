<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:id="@+id/linear_view1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="@dimen/_14sdp"
        android:layout_width="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_height="wrap_content"
        android:background="@color/purple_500"
        >

        <TextView
            android:textColor="@color/white"
            android:text="@string/bahasa"
            android:textSize="@dimen/_14sdp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>
    <RadioGroup
        android:layout_marginTop="@dimen/_4sdp"
        android:id="@+id/radio_group"
        android:layout_marginStart="@dimen/_4sdp"
        android:layout_marginEnd="@dimen/_4sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/linear_view1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <RadioButton
            android:id="@+id/rb_language_indonesia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/radio_flat_selector"
            android:button="@android:color/transparent"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/_22sdp"
            android:paddingRight="@dimen/_22sdp"
            android:paddingTop="@dimen/_3sdp"
            android:paddingBottom="@dimen/_3sdp"
            android:text="@string/indonesia"
            android:textColor="@color/color_flat_text_selector" />

        <RadioButton
            android:id="@+id/rb_language_english"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/radio_flat_selector"
            android:button="@android:color/transparent"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/_22sdp"
            android:paddingTop="@dimen/_3sdp"
            android:paddingRight="@dimen/_22sdp"
            android:paddingBottom="@dimen/_3sdp"
            android:text="@string/english"
            android:textColor="@color/color_flat_text_selector" />

        <RadioButton
            android:id="@+id/rb_language_thailand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/radio_flat_selector"
            android:button="@android:color/transparent"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/_22sdp"
            android:paddingTop="@dimen/_3sdp"
            android:paddingRight="@dimen/_22sdp"
            android:paddingBottom="@dimen/_3sdp"
            android:text="@string/thailand"
            android:textColor="@color/color_flat_text_selector" />
        <RadioButton
            android:id="@+id/rb_language_vietnamese"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/radio_flat_selector"
            android:button="@android:color/transparent"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/_22sdp"
            android:paddingTop="@dimen/_3sdp"
            android:paddingRight="@dimen/_22sdp"
            android:paddingBottom="@dimen/_3sdp"
            android:text="@string/vietnamese"
            android:textColor="@color/color_flat_text_selector" />
        <RadioButton
            android:id="@+id/rb_language_india"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/radio_flat_selector"
            android:button="@android:color/transparent"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/_22sdp"
            android:paddingTop="@dimen/_3sdp"
            android:paddingRight="@dimen/_22sdp"
            android:paddingBottom="@dimen/_3sdp"
            android:text="@string/india"
            android:textColor="@color/color_flat_text_selector" />
    </RadioGroup>


</androidx.constraintlayout.widget.ConstraintLayout>