<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/_8sdp"
    android:layout_marginTop="@dimen/_4sdp"
    android:layout_marginEnd="@dimen/_8sdp"
    android:layout_marginBottom="@dimen/_4sdp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="@dimen/_4sdp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/_8sdp">

        <ImageView
            android:id="@+id/img_view_profile"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:background="@color/preview"
            android:textColor="@android:color/transparent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:background="@color/preview"
            android:text="@string/nama"
            android:textColor="@android:color/transparent"
            android:textSize="@dimen/_12sdp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/img_view_profile"
            app:layout_constraintStart_toEndOf="@id/img_view_profile"
            app:layout_constraintTop_toTopOf="@id/img_view_profile" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_notif"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@color/preview"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:textColor="@android:color/transparent"
            app:backgroundTint="@color/preview"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/img_view_dibuat_pada"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:background="@color/preview"
            android:textColor="@android:color/transparent"
            app:layout_constraintStart_toStartOf="@id/img_view_profile"
            app:layout_constraintTop_toBottomOf="@id/img_view_profile" />

        <TextView
            android:id="@+id/tv_dibuat_pada"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:background="@color/preview"
            android:text="@string/_12_22_2021"
            android:textColor="@android:color/transparent"
            android:textStyle="italic"
            app:layout_constraintBottom_toBottomOf="@id/img_view_dibuat_pada"
            app:layout_constraintStart_toEndOf="@id/img_view_dibuat_pada"
            app:layout_constraintTop_toTopOf="@id/img_view_dibuat_pada" />

        <ImageView
            android:id="@+id/img_description"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:background="@color/preview"
            android:textColor="@android:color/transparent"
            app:layout_constraintStart_toStartOf="@id/img_view_dibuat_pada"
            app:layout_constraintTop_toBottomOf="@id/img_view_dibuat_pada" />

        <TextView
            android:id="@+id/tv_deskription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:background="@color/preview"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/_intro_deskription"
            android:textColor="@android:color/transparent"
            android:textStyle="normal"
            app:layout_constraintBottom_toBottomOf="@id/img_description"
            app:layout_constraintEnd_toStartOf="@id/btn_notif"
            app:layout_constraintStart_toEndOf="@id/img_description"
            app:layout_constraintTop_toTopOf="@id/img_description" />

        <ImageView
            android:id="@+id/img_jumlah"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:background="@color/preview"
            android:textColor="@android:color/transparent"
            app:layout_constraintStart_toStartOf="@id/img_description"
            app:layout_constraintTop_toBottomOf="@id/img_description" />

        <TextView
            android:id="@+id/tv_jumlah"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:background="@color/preview"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/_rp_3000_000"
            android:textColor="@android:color/transparent"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/img_jumlah"
            app:layout_constraintEnd_toStartOf="@id/btn_notif"
            app:layout_constraintStart_toEndOf="@id/img_jumlah"
            app:layout_constraintTop_toTopOf="@id/img_jumlah" />

        <LinearLayout
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_24sdp"
            android:background="@color/preview"
            android:orientation="horizontal"
            android:textColor="@android:color/transparent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/btn_notif"></LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>