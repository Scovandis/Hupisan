<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:elevation="@dimen/_3sdp"
    app:cardCornerRadius="@dimen/_5sdp"
    app:cardElevation="@dimen/_4sdp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="true"
    >
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:background="@color/preview"
            android:id="@+id/imv_random_color"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_margin="@dimen/_4sdp"
            android:scaleType="center"
            android:clipToOutline="true"
            app:layout_constraintBottom_toBottomOf="parent"
            android:src="@drawable/rounded_outline"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_50sdp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:id="@+id/linear1"
            android:background="@color/preview"
            android:textColor="@android:color/transparent"
            android:layout_marginStart="@dimen/_2sdp"
            android:layout_marginEnd="@dimen/_2sdp"
            app:layout_constraintTop_toTopOf="@id/imv_random_color"
            app:layout_constraintStart_toEndOf="@id/imv_random_color"
            android:gravity="center">
            <TextView
                android:text="@string/anda_telah_menambahkan"
                android:textStyle="italic"
                android:paddingStart="@dimen/_4sdp"
                android:background="@color/preview"
                android:textColor="@android:color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:layout_width="wrap_content"
                android:paddingStart="@dimen/_4sdp"
                android:paddingEnd="@dimen/_4sdp"
                android:background="@color/preview"
                android:textColor="@android:color/transparent"
                android:id="@+id/tv_status_type"
                android:textStyle="bold"
                android:text="@string/hutang"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="@string/sebesar"
                android:textStyle="italic"
                android:layout_width="wrap_content"
                android:background="@color/preview"
                android:textColor="@android:color/transparent"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <TextView
            app:layout_constraintTop_toBottomOf="@id/linear1"
            app:layout_constraintStart_toStartOf="@id/linear1"
            android:layout_width="wrap_content"
            android:paddingStart="@dimen/_4sdp"
            android:paddingEnd="@dimen/_4sdp"
            android:id="@+id/tv_jumlah_nominal"
            android:background="@color/preview"
            android:textColor="@android:color/transparent"
            android:textStyle="bold"
            android:text="@string/_rp_3000_000"
            android:layout_height="wrap_content"/>


        <View
            android:layout_width="0dp"
            app:layout_constraintStart_toEndOf="@id/imv_random_color"
            android:layout_height="@dimen/_1sdp"
            app:layout_constraintTop_toBottomOf="@id/tv_jumlah_nominal"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="@color/transparantBlack15"
            android:layout_marginTop="@dimen/_2sdp"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.cardview.widget.CardView>