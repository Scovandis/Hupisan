<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:isScrollContainer="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER BANNER -->
            <LinearLayout
                android:id="@+id/linear1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/hupisan_primary_dark"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <TextView
                    android:id="@+id/tv_prompt_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/apakah_anda_ingin"
                    android:textColor="@color/transparentwhite"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_status_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/menambahkan_hutang"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/dari"
                        android:textColor="@color/transparentwhite"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_username"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Budi Santoso" />
                </LinearLayout>
            </LinearLayout>

            <!-- DATE & TOTAL ROW -->
            <RelativeLayout
                android:id="@+id/relative1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_alert_dibuat_pada"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:maxLines="1"
                    android:textColor="@color/hupisan_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="italic"
                    tools:text="21/11/2026 19:30" />

                <TextView
                    android:id="@+id/tv_total_hutang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:maxLines="1"
                    android:textColor="@color/hupisan_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Rp 250.000" />
            </RelativeLayout>

            <!-- INPUT FIELDS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/et_jumlah_alert"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/jumlah_bayar"
                    android:textColorHint="@color/hupisan_text_muted"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:boxStrokeColor="@color/hupisan_primary"
                    app:counterEnabled="true"
                    app:counterMaxLength="12"
                    app:counterTextColor="@color/hupisan_text_muted"
                    app:errorEnabled="true"
                    app:helperText="@string/masukkan_jumlah_nominal"
                    app:helperTextEnabled="true"
                    app:helperTextTextColor="@color/hupisan_text_muted"
                    app:hintTextColor="@color/hupisan_primary"
                    app:prefixText="@string/dolar"
                    app:prefixTextColor="@color/hupisan_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="12"
                        android:maxLines="1"
                        android:textColor="@color/hupisan_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/et_keterangan_alert"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:hint="@string/deskripsi"
                    android:textColorHint="@color/hupisan_text_muted"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:boxStrokeColor="@color/hupisan_primary"
                    app:counterEnabled="true"
                    app:counterMaxLength="210"
                    app:counterTextColor="@color/hupisan_text_muted"
                    app:errorEnabled="true"
                    app:helperText="@string/bila_ada_keterangan_yang_di_hutang"
                    app:helperTextEnabled="true"
                    app:helperTextTextColor="@color/hupisan_text_muted"
                    app:hintTextColor="@color/hupisan_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLength="210"
                        android:maxLines="4"
                        android:textColor="@color/hupisan_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
