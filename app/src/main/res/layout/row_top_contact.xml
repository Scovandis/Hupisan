<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp">

    <!-- Rank badge circle (1, 2, 3) -->
    <TextView
        android:id="@+id/tv_rank_number"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_circle_green_badge"
        android:fontFamily="sans-serif-bold"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="12sp"
        tools:text="1" />

    <!-- Name & Due date -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_contact_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-bold"
            android:maxLines="1"
            android:textColor="@color/hupisan_text_primary"
            android:textSize="14sp"
            tools:text="Budi Santoso" />

        <TextView
            android:id="@+id/tv_contact_due"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/hupisan_text_secondary"
            android:textSize="12sp"
            tools:text="Tempo: 19 Nov 2026" />
    </LinearLayout>

    <!-- Nominal -->
    <TextView
        android:id="@+id/tv_contact_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:fontFamily="sans-serif-bold"
        android:textColor="@color/hupisan_text_primary"
        android:textSize="14sp"
        tools:text="Rp 500.000" />

    <!-- WA reminder button -->
    <FrameLayout
        android:id="@+id/btn_contact_wa"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_circle_icon_green"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_baseline_check_24"
            app:tint="@color/hupisan_primary" />
    </FrameLayout>

</LinearLayout>
