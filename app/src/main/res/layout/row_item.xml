<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:elevation="@dimen/_3sdp"
    app:cardCornerRadius="@dimen/_5sdp"
    app:cardElevation="@dimen/_2sdp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imv_random_color"
            app:layout_constraintTop_toTopOf="@id/linear1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/linear1"
            android:layout_height="@dimen/_35sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:theme="@style/roundedCorners"
            android:layout_width="@dimen/_35sdp"
            />

        <ImageView
            android:layout_width="@dimen/_20sdp"
            app:layout_constraintTop_toTopOf="@id/imv_random_color"
            app:layout_constraintBottom_toBottomOf="@id/imv_random_color"
            app:layout_constraintStart_toStartOf="@id/imv_random_color"
            android:src="@drawable/ic_user_alert"
            app:layout_constraintEnd_toEndOf="@id/imv_random_color"
            android:layout_height="@dimen/_20sdp"
            android:id="@+id/img_src_bg_gender"/>

        <LinearLayout
            app:layout_constraintEnd_toStartOf="@id/btn_notif"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/imv_random_color"
            android:layout_marginBottom="@dimen/_4sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_width="0dp"
            android:id="@+id/linear1"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:maxLength="15"
                android:text="@string/nama"
                android:ellipsize="end"
                android:textColor="@color/black"
                android:textSize="@dimen/_16sdp"
                android:textStyle="bold"/>

            <TextView
                android:layout_marginTop="@dimen/_2sdp"
                android:id="@+id/tv_dibuat_pada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/_12_22_2021"

                android:textColor="@color/black"
                android:textStyle="italic"
                />

            <TextView
                android:id="@+id/tv_deskription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/_intro_deskription"
                android:textStyle="normal"
                android:textSize="@dimen/_14sdp"
                />

            <TextView
                android:id="@+id/tv_jumlah"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:textSize="@dimen/_14sdp"
                android:maxLines="1"
                android:text="@string/_rp_3000_000"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_notif"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:backgroundTint="@color/purple_500"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:layout_margin="@dimen/_4sdp"
            app:icon="@drawable/ic_notifications_active_black_24dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:layout_constraintStart_toEndOf="@id/linear1"
            app:iconTint="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/linear1"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Button.Circle" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>