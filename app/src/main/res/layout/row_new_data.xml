<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:elevation="@dimen/_2sdp"
    app:cardCornerRadius="@dimen/_5sdp"
    app:cardElevation="@dimen/_2sdp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="true"
    >
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imv_random_color"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_margin="@dimen/_4sdp"
            android:layout_height="@dimen/_50sdp"
            android:theme="@style/roundedCorners"
            android:layout_width="@dimen/_50sdp"
             />

        <TextView
            app:layout_constraintTop_toTopOf="@id/imv_random_color"
            app:layout_constraintStart_toStartOf="@id/imv_random_color"
            app:layout_constraintBottom_toBottomOf="@id/imv_random_color"
            app:layout_constraintEnd_toEndOf="@id/imv_random_color"
            android:translationZ="@dimen/_5sdp"
            android:textSize="@dimen/_20sdp"
            android:text="@string/gondres"
            android:maxLength="2"
            android:id="@+id/tv_username"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <androidx.cardview.widget.CardView
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:rotation="-45"
            android:layout_marginTop="@dimen/_7sdp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="@dimen/_1sdp"
            android:translationZ="@dimen/_5sdp"
            app:cardCornerRadius="@dimen/_5sdp"
            app:cardElevation="@dimen/_1sdp"
            android:background="@color/publicRed"
            android:backgroundTint="@color/publicRed"
            app:cardPreventCornerOverlap="false"
            >
            <TextView
                android:id="@+id/tv_label_new"
                android:textColor="@color/white"
                android:text="@string/baru"
                android:paddingStart="@dimen/_2sdp"
                android:paddingEnd="@dimen/_2sdp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            android:orientation="horizontal"
            android:id="@+id/linear1"
            android:layout_marginStart="@dimen/_2sdp"
            android:layout_marginEnd="@dimen/_2sdp"
            app:layout_constraintTop_toTopOf="@id/imv_random_color"
            app:layout_constraintStart_toEndOf="@id/imv_random_color"
            android:gravity="start|center">
            <TextView
                android:text="@string/anda_telah_menambahkan"
                android:textStyle="italic"
                android:paddingStart="@dimen/_4sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:layout_width="wrap_content"
                android:paddingStart="@dimen/_4sdp"
                android:paddingEnd="@dimen/_4sdp"
                android:id="@+id/tv_status_type"
                android:textColor="@color/purple_500"
                android:textStyle="bold"
                android:text="@string/hutang"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="@string/sebesar"
                android:textStyle="italic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <TextView
            app:layout_constraintTop_toBottomOf="@id/linear1"
            app:layout_constraintStart_toStartOf="@id/linear1"
            android:layout_width="wrap_content"
            android:paddingStart="@dimen/_4sdp"
            android:paddingEnd="@dimen/_4sdp"
            android:id="@+id/tv_jumlah_nominal"
            android:textColor="@color/purple_500"
            android:textStyle="bold"
            android:text="@string/_rp_3000_000"
            android:layout_height="wrap_content"/>
        <View
            android:layout_width="0dp"
            app:layout_constraintStart_toEndOf="@id/imv_random_color"
            android:layout_height="@dimen/_1sdp"
            app:layout_constraintTop_toBottomOf="@id/tv_jumlah_nominal"
            android:id="@+id/view1"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_marginEnd="@dimen/_4sdp"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="@color/transparantBlack15"
            android:layout_marginTop="@dimen/_2sdp"
            />

        <LinearLayout
            app:layout_constraintStart_toStartOf="@id/linear1"
            android:paddingStart="@dimen/_4sdp"
            android:paddingEnd="@dimen/_4sdp"
            app:layout_constraintTop_toBottomOf="@+id/view1"
            android:layout_width="0dp"
            android:layout_marginTop="@dimen/_2sdp"
            android:layout_marginBottom="@dimen/_4sdp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/ditambahkan_pada"
                android:layout_width="wrap_content"
                android:textStyle="italic"
                android:textSize="@dimen/_10sdp"
                android:layout_height="wrap_content"/>
            <TextView
                android:layout_width="wrap_content"
                android:paddingStart="@dimen/_4sdp"
                android:paddingEnd="@dimen/_4sdp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:id="@+id/tv_create_at"
                android:text="@string/_12_22_2021"
                android:textSize="@dimen/_11sdp"
                android:layout_height="wrap_content"/>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.cardview.widget.CardView>