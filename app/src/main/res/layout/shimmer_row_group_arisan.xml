<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imv_random_color"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_height="@dimen/_35sdp"
        android:layout_margin="@dimen/_8sdp"
        android:background="@color/preview"
        android:textColor="@android:color/transparent"
        android:theme="@style/roundedCorners"
        android:layout_width="@dimen/_35sdp"
        />

    <ImageView
        android:layout_width="@dimen/_20sdp"
        app:layout_constraintTop_toTopOf="@id/imv_random_color"
        app:layout_constraintBottom_toBottomOf="@id/imv_random_color"
        app:layout_constraintStart_toStartOf="@id/imv_random_color"
        android:background="@color/preview"
        android:textColor="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="@id/imv_random_color"
        android:layout_height="@dimen/_20sdp"
        android:id="@+id/img_src_bg_group"/>
    <LinearLayout
        android:layout_marginEnd="@dimen/_8sdp"
        android:id="@+id/linear1"
        android:orientation="vertical"
        android:layout_width="0dp"
        app:layout_constraintTop_toTopOf="@id/imv_random_color"
        app:layout_constraintStart_toEndOf="@id/imv_random_color"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="@dimen/_8sdp"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/name_group"
            android:layout_width="match_parent"
            android:textSize="@dimen/_16sdp"
            android:textStyle="bold"
            android:background="@color/preview"
            android:textColor="@android:color/transparent"
            android:text="@string/gondres"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:layout_width="match_parent"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/member"
                android:background="@color/preview"
                android:textColor="@android:color/transparent"
                />
            <TextView
                android:id="@+id/tv_jumlah_member"
                android:layout_marginStart="@dimen/_8sdp"
                android:text="@string/_98"
                android:background="@color/preview"
                android:textColor="@android:color/transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/preview"
                android:textColor="@android:color/transparent"
                android:text="@string/hadiah"
                />
            <TextView
                android:id="@+id/tv_jumlah_hadiah"
                android:layout_marginStart="@dimen/_8sdp"
                android:background="@color/preview"
                android:textColor="@android:color/transparent"
                android:text="@string/_rp_3000_000"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/preview"
                android:textColor="@android:color/transparent"
                android:text="@string/nominal"
                />
            <TextView
                android:id="@+id/tv_jumlah_nominal"
                android:layout_marginStart="@dimen/_8sdp"
                android:text="@string/_rp_3000_000"
                android:background="@color/preview"
                android:textColor="@android:color/transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/view1"
        android:layout_width="match_parent"
        app:layout_constraintTop_toBottomOf="@id/linear1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginStart="@dimen/_8sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        android:background="@color/preview"
        android:textColor="@android:color/transparent"
        android:layout_height="1dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>