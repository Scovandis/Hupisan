<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:background="@color/transparantBlack5"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    app:cardPreventCornerOverlap="false"
    android:padding="@dimen/_2sdp"
    app:cardUseCompatPadding="true"
    android:elevation="@dimen/_3sdp"
    app:cardCornerRadius="@dimen/_5sdp"
    app:cardElevation="@dimen/_2sdp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

        <LinearLayout
            android:id="@+id/linear1"
            android:orientation="horizontal"
            android:layout_margin="@dimen/_4sdp"
            android:padding="@dimen/_2sdp"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tv_number_of_add"
                android:text="@string/_0"
                android:paddingStart="@dimen/_5sdp"
                android:paddingEnd="@dimen/_5sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <View
                android:layout_width="1dp"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                android:background="@color/transparantBlack15"
                android:layout_height="match_parent"/>
            <TextView
                android:text="@string/gondres"
                android:textStyle="bold"
                android:id="@+id/tv_username"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:maxLines="1"
                android:paddingStart="@dimen/_12sdp"
                android:paddingEnd="@dimen/_12sdp"
                android:layout_height="wrap_content"/>

        </LinearLayout>
<!--        <View-->
<!--            android:id="@+id/view1"-->
<!--            android:layout_width="0dp"-->
<!--            app:layout_constraintTop_toBottomOf="@id/linear1"-->
<!--            app:layout_constraintEnd_toEndOf="@id/linear1"-->
<!--            app:layout_constraintStart_toStartOf="@id/linear1"-->
<!--            android:layout_marginTop="@dimen/_2sdp"-->
<!--            android:background="@color/transparantBlack75"-->
<!--            android:layout_height="1dp"/>-->

</androidx.cardview.widget.CardView>