<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Row: Name + Type Tag + Due Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_reminder_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/hupisan_text_primary"
                android:textSize="15.5sp"
                android:textStyle="bold"
                tools:text="Budi Santoso" />

            <TextView
                android:id="@+id/tv_reminder_due_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_belum_lunas"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="@color/hupisan_debt_text"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Lewat Tempo" />
        </LinearLayout>

        <!-- Second Row: Type Badge & Amount -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_reminder_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_neutral"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@color/hupisan_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Hutang" />

            <TextView
                android:id="@+id/tv_reminder_amount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textColor="@color/hupisan_debt_text"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Rp 500.000" />
        </LinearLayout>

        <!-- Schedule & Description -->
        <TextView
            android:id="@+id/tv_reminder_schedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/hupisan_text_secondary"
            android:textSize="12.5sp"
            tools:text="Jatuh Tempo: 21/11/2026 • 09:00" />

        <TextView
            android:id="@+id/tv_reminder_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/hupisan_text_muted"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Pinjaman untuk keperluan bulanan"
            tools:visibility="visible" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="@color/hupisan_card_stroke" />

        <!-- Bottom Action Row: Alarm Switch + Tunda 1 Jam -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_alarm_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/hupisan_text_secondary"
                android:textSize="12sp"
                tools:text="Alarm • 09:00" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_snooze_1h"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:minWidth="0dp"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="@string/pengingat_tunda_1_jam"
                android:textAllCaps="false"
                android:textColor="@color/hupisan_primary"
                android:textSize="11.5sp"
                android:textStyle="bold"
                app:cornerRadius="18dp"
                app:strokeColor="@color/hupisan_primary"
                app:strokeWidth="1dp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_item_alarm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/white"
                app:trackTint="@color/switch_track_selector" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
