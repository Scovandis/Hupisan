    <RelativeLayout
        android:id="@+id/relative2"
        android:layout_width="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_height="@dimen/_40sdp">

        <ImageView
            android:id="@+id/img_bahasa"
            android:layout_width="@dimen/_40sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true" />

        <TextView
            android:id="@+id/tv_bahasa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_toEndOf="@id/img_bahasa"
            android:gravity="center_vertical"
            android:text="@string/bahasa"
            android:textSize="@dimen/_22sdp" />
    </RelativeLayout>

    <View
        android:id="@+id/view2"
        app:layout_constraintTop_toBottomOf="@id/relative2"
        android:background="@color/transparantBlack15"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"/>
    <RelativeLayout
        android:id="@+id/relative3"
        android:layout_width="match_parent"
        app:layout_constraintTop_toBottomOf="@id/view2"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_height="@dimen/_40sdp">

        <ImageView
            android:id="@+id/img_trims"
            android:layout_width="@dimen/_40sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true" />

        <TextView
            android:id="@+id/tv_trems"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_toEndOf="@id/img_trims"
            android:gravity="center_vertical"
            android:text="@string/trems_and_conditions"
            android:textSize="@dimen/_22sdp" />
    </RelativeLayout>

    <View
        android:id="@+id/view3"
        app:layout_constraintTop_toBottomOf="@id/relative3"
        android:background="@color/transparantBlack15"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"/>
    <RelativeLayout
        android:id="@+id/relative4"
        android:layout_width="match_parent"
        app:layout_constraintTop_toBottomOf="@id/view3"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_height="@dimen/_40sdp">

        <ImageView
            android:id="@+id/img_privacy"
            android:layout_width="@dimen/_40sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true" />

        <TextView
            android:id="@+id/tv_privacy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_toEndOf="@id/img_privacy"
            android:gravity="center_vertical"
            android:text="@string/privacy_policy"
            android:textSize="@dimen/_22sdp" />
    </RelativeLayout>

    <View
        app:layout_constraintTop_toBottomOf="@id/relative4"
        android:background="@color/transparantBlack15"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/frame_layout">

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>