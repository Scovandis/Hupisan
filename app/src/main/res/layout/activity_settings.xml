<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/constraint"
    android:background="@color/transparantBlack5"
    tools:context=".view.pengaturan.SettingsActivity"
    >
    <LinearLayout
        android:layout_width="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="@dimen/_12sdp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_height="wrap_content">
        <TextView
            android:text="@string/umum"
            android:textStyle="bold"
            android:textSize="@dimen/_16sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <androidx.cardview.widget.CardView
            android:clipChildren="false"
            android:clipToPadding="false"
            app:cardPreventCornerOverlap="false"
            app:cardUseCompatPadding="true"
            android:elevation="@dimen/_3sdp"
            app:cardCornerRadius="@dimen/_5sdp"
            app:cardElevation="@dimen/_3sdp"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:padding="@dimen/_12sdp"
                android:layout_height="match_parent">

                <RelativeLayout
                    android:id="@+id/relative2"
                    android:layout_width="match_parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:gravity="center_vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_height="@dimen/_40sdp">

                    <ImageView
                        android:src="@drawable/ic_languages"
                        android:id="@+id/img_bahasa"
                        android:layout_width="@dimen/_40sdp"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_alignParentStart="true"
                        android:padding="@dimen/_8sdp"
                        android:layout_alignParentTop="true"
                        android:layout_marginStart="@dimen/_4sdp" />

                    <TextView
                        android:id="@+id/tv_bahasa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginStart="@dimen/_4sdp"
                        android:layout_toEndOf="@id/img_bahasa"
                        android:gravity="center_vertical"
                        android:text="@string/bahasa"
                        android:textSize="@dimen/_14sdp" />
                </RelativeLayout>

                <View
                    android:id="@+id/view2"
                    app:layout_constraintTop_toBottomOf="@id/relative2"
                    android:background="@color/transparantBlack15"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"/>
                <RelativeLayout
                    android:id="@+id/relative3"
                    android:layout_width="match_parent"
                    app:layout_constraintTop_toBottomOf="@id/view2"
                    android:gravity="center_vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_height="@dimen/_40sdp">

                    <ImageView
                        android:id="@+id/img_trims"
                        android:layout_width="@dimen/_40sdp"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_alignParentStart="true"
                        android:src="@drawable/ic_terms"
                        android:padding="@dimen/_8sdp"
                        android:layout_alignParentTop="true"
                        android:layout_marginStart="@dimen/_4sdp" />

                    <TextView
                        android:id="@+id/tv_trems"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginStart="@dimen/_4sdp"
                        android:layout_toEndOf="@id/img_trims"
                        android:gravity="center_vertical"
                        android:text="@string/trems_and_conditions"
                        android:textSize="@dimen/_14sdp" />
                </RelativeLayout>

                <View
                    android:id="@+id/view3"
                    app:layout_constraintTop_toBottomOf="@id/relative3"
                    android:background="@color/transparantBlack15"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"/>
                <RelativeLayout
                    android:id="@+id/relative4"
                    android:layout_width="match_parent"
                    app:layout_constraintTop_toBottomOf="@id/view3"
                    android:gravity="center_vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_height="@dimen/_40sdp">

                    <ImageView
                        android:id="@+id/img_privacy"
                        android:layout_width="@dimen/_40sdp"
                        android:layout_marginStart="@dimen/_4sdp"
                        android:layout_height="@dimen/_40sdp"
                        android:src="@drawable/ic_trems_condition"
                        android:padding="@dimen/_8sdp"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true" />

                    <TextView
                        android:id="@+id/tv_privacy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginStart="@dimen/_4sdp"
                        android:layout_toEndOf="@id/img_privacy"
                        android:gravity="center_vertical"
                        android:text="@string/privacy_policy"
                        android:textSize="@dimen/_14sdp" />
                </RelativeLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:text="@string/support"
            android:layout_marginTop="@dimen/_16sdp"
            android:textStyle="bold"
            android:textSize="@dimen/_16sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <androidx.cardview.widget.CardView
            android:clipChildren="false"
            android:clipToPadding="false"
            app:cardPreventCornerOverlap="false"
            app:cardUseCompatPadding="true"
            android:elevation="@dimen/_3sdp"
            app:cardCornerRadius="@dimen/_5sdp"
            app:cardElevation="@dimen/_3sdp"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:padding="@dimen/_12sdp"
                android:layout_height="match_parent">
                    <RelativeLayout
                        android:id="@+id/relative5"
                        android:layout_width="match_parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:gravity="center_vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_height="@dimen/_40sdp">

                        <ImageView
                            android:id="@+id/img_donate"
                            android:layout_width="@dimen/_40sdp"
                            android:layout_marginStart="@dimen/_4sdp"
                            android:layout_height="@dimen/_40sdp"
                            android:padding="@dimen/_8sdp"
                            android:src="@drawable/ic_donation"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentTop="true" />

                        <TextView
                            android:id="@+id/tv_donate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:layout_marginStart="@dimen/_4sdp"
                            android:layout_toEndOf="@id/img_donate"
                            android:gravity="center_vertical"
                            android:text="@string/donasi_dengan_paypal"
                            android:textSize="@dimen/_14sdp" />
                    </RelativeLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    <TextView
        android:id="@+id/tv_app_version"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="@dimen/_44sdp"
        android:textSize="@dimen/_10sdp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ProgressBar
        android:id="@+id/progressbar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

</androidx.constraintlayout.widget.ConstraintLayout>