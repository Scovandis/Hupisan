<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hupisan_page_bg"
    android:orientation="vertical"
    tools:context=".view.statistic.StatisticActivity">

    <!-- TOP TOOLBAR -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbarLayout"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/hupisan_card_bg"
        android:elevation="1dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/kembali"
            android:padding="6dp"
            android:src="@drawable/ic_baseline_arrow_back_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/hupisan_text_primary" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="@string/title_laporan_statistik"
            android:textColor="@color/hupisan_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnCalendar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/kalender"
            android:padding="6dp"
            android:src="@drawable/ic_hupisan_calendar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/hupisan_text_primary" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- FILTER PILLS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnFilterMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_filter_pill_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="7dp"
                    android:text="@string/filter_bulan_ini"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnFilter5Month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_pill_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="7dp"
                    android:text="@string/filter_tiga_bulan"
                    android:textColor="@color/hupisan_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnFilter6Month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_pill_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="7dp"
                    android:text="@string/semua"
                    android:textColor="@color/hupisan_text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- 1. MONTHLY SCORECARD CARD (Rekap Performa) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_scorecard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/hupisan_card_bg"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardPreventCornerOverlap="false"
                app:cardUseCompatPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/rekap_performa_keuangan"
                        android:textColor="@color/hupisan_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_scorecard_period"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/filter_bulan_ini"
                        android:textColor="@color/hupisan_text_muted"
                        android:textSize="12sp" />

                    <!-- Metric 1: Total Dipinjamkan -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/total_uang_dipinjamkan"
                            android:textColor="@color/hupisan_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_total_dipinjamkan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="Rp 0"
                            android:textColor="@color/hupisan_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="@color/hupisan_card_stroke" />

                    <!-- Metric 2: Berhasil Ditagih / Dilunasi -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_circle_green_badge" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/berhasil_ditagih_lunas"
                                android:textColor="@color/hupisan_text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_total_ditagih"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="Rp 0"
                            android:textColor="@color/hupisan_paid_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="@color/hupisan_card_stroke" />

                    <!-- Metric 3: Masih Tertunggak -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_circle_red_badge" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/masih_tertunggak"
                                android:textColor="@color/hupisan_text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_total_tertunggak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="Rp 0"
                            android:textColor="@color/hupisan_debt_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Visual Ratio Bar (Hijau vs Merah) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif"
                                android:text="@string/rasio_pelunasan"
                                android:textColor="@color/hupisan_text_muted"
                                android:textSize="11.5sp" />

                            <TextView
                                android:id="@+id/tv_ratio_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="0% Tertagih"
                                android:textColor="@color/hupisan_paid_text"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Stacked Linear Bar -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="12dp"
                            android:background="@drawable/bg_pill_inactive"
                            android:orientation="horizontal"
                            android:weightSum="100">

                            <View
                                android:id="@+id/bar_ratio_paid"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0"
                                android:background="@drawable/bg_circle_green_badge" />

                            <View
                                android:id="@+id/bar_ratio_unpaid"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="100"
                                android:background="@drawable/bg_circle_red_badge" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 2. TOP CONTACT SUMMARY CARD (Prioritas Piutang Terbesar) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_top_contacts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/hupisan_card_bg"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardPreventCornerOverlap="false"
                app:cardUseCompatPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/prioritas_piutang_terbesar"
                        android:textColor="@color/hupisan_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/sub_prioritas_piutang"
                        android:textColor="@color/hupisan_text_muted"
                        android:textSize="12sp" />

                    <!-- Top Contacts Container -->
                    <LinearLayout
                        android:id="@+id/container_top_contacts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 3. EKSPOR RINGKASAN BUTTON (Share WhatsApp) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share_report"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="@color/hupisan_primary"
                android:fontFamily="sans-serif-bold"
                android:text="@string/bagikan_ringkasan_laporan"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:cornerRadius="26dp"
                app:elevation="3dp" />

            <!-- COMPATIBILITY STUBS FOR LEGACY CODE (Preserved to avoid binding errors) -->
            <View
                android:id="@+id/cardTotalHutang"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <View
                android:id="@+id/cardTotalPiutang"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/tvStatTotalHutang"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/tvStatTotalPiutang"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <org.eazegraph.lib.charts.PieChart
                android:id="@+id/piechart"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/tvDonutPercentage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/tvDonutLabel"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/tvLegendHutangPercent"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/tvLegendPiutangPercent"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <View
                android:id="@+id/barHutangM1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <View
                android:id="@+id/barPiutangM1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <View
                android:id="@+id/barHutangM2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <View
                android:id="@+id/barPiutangM2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <View
                android:id="@+id/barHutangM3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <View
                android:id="@+id/barPiutangM3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/tvLabelM1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/tvLabelM2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/tvLabelM3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <View
                android:id="@+id/tabLayout"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <View
                android:id="@+id/view_pager"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
