<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_8sdp"
    android:padding="@dimen/_4sdp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:elevation="@dimen/_3sdp"
    app:cardCornerRadius="@dimen/_5sdp"
    app:cardElevation="@dimen/_2sdp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="true"
    >
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:padding="@dimen/_8sdp"
        android:layout_height="wrap_content">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imv_random_color"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:background="@color/preview"
            android:textColor="@android:color/transparent"
            android:layout_height="@dimen/_35sdp"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_margin="@dimen/_8sdp"
            android:theme="@style/roundedCorners"
            android:layout_width="@dimen/_35sdp"
            />

        <ImageView
            android:layout_width="@dimen/_20sdp"
            app:layout_constraintTop_toTopOf="@id/imv_random_color"
            app:layout_constraintBottom_toBottomOf="@id/imv_random_color"
            app:layout_constraintStart_toStartOf="@id/imv_random_color"
            app:layout_constraintEnd_toEndOf="@id/imv_random_color"
            android:layout_height="@dimen/_20sdp"
            android:id="@+id/img_src_bg_gender"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:maxLength="8"
            android:ellipsize="end"
            app:layout_constraintTop_toBottomOf="@id/imv_random_color"
            app:layout_constraintStart_toStartOf="@id/imv_random_color"
            app:layout_constraintEnd_toEndOf="@id/imv_random_color"
            android:layout_marginTop="@dimen/_4sdp"
            android:background="@color/preview"
            android:textColor="@android:color/transparent"
            android:text="@string/gondres"
            android:id="@+id/tv_username"
            android:textSize="@dimen/_16sdp"/>
        <TextView
            android:id="@+id/tv_bayar"
            android:text="@string/_rp_3000_000"
            android:layout_width="wrap_content"
            android:maxLines="1"
            android:maxLength="8"
            android:ellipsize="end"
            android:background="@color/preview"
            android:textColor="@android:color/transparent"
            app:layout_constraintTop_toBottomOf="@id/tv_username"
            app:layout_constraintStart_toStartOf="@id/tv_username"
            app:layout_constraintEnd_toEndOf="@id/tv_username"
            android:layout_height="wrap_content"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>