<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HHHH">
        <activity
            android:name=".view.bantuan.BantuanActivity"
            android:exported="false" />
        <activity
            android:name=".view.arisan.FitureArisanActivity"
            android:exported="false" />
        <activity
            android:name=".view.arisan.AddMemberActivity"
            android:exported="false"
            android:theme="@style/Theme.HHHH.noActionBar"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".view.arisan.ArisanMemberActivity"
            android:exported="false"
            android:theme="@style/Theme.HHHH.noActionBar" />
        <activity
            android:name=".view.arisan.AddArisanActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".view.arisan.ArisanActivity"
            android:exported="false"
            android:theme="@style/Theme.HHHH.noActionBar"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".view.pengaturan.SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".view.lunas.LunasActivity"
            android:exported="false" />
        <activity
            android:name=".view.statistic.StatisticActivity"
            android:exported="false" />
        <activity
            android:name=".view.onboarding.IntroActivity"
            android:exported="false"
            android:theme="@style/Theme.HHHH.noActionBar" />
        <activity
            android:name=".view.main.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.HHHH.noActionBar" />
        <activity
            android:name=".view.detail_hutang.DetailHutangActivity"
            android:exported="false"
            android:theme="@style/Theme.HHHH.noActionBar"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".view.add_hutang.AddHutangActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".view.hutang.HutangActivity"
            android:exported="false" />
        <activity
            android:name=".view.splashscreen.SplashScreenActivity"
            android:exported="true"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notification.service.NotificationService"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>